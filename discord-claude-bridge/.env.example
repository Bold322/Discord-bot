# ---------- Хоёуланд хэрэгтэй ----------
# Railway Postgres-ийн public connection string (bridge Mac дээрээс холбогдох тул PUBLIC URL хэрэгтэй)
DATABASE_URL=postgresql://postgres:password@host.proxy.rlwy.net:12345/railway

# ---------- Discord bot (Railway дээр ажиллана) ----------
DISCORD_TOKEN=your-bot-token
# Ажиглах channel ID-ууд (таслалаар тусгаарлана). Хоосон бол бүх channel.
WATCH_CHANNEL_IDS=123456789012345678
# Хэнийг mention хийхэд Claude хариулах вэ. Хоосон бол bot-ыг өөрийг нь mention хийхэд.
TRIGGER_USER_IDS=
# Хариулт шалгах давтамж (мс)
BOT_POLL_INTERVAL_MS=3000
# Railway bucket: хавсаргасан эх файл ба зассан файлыг хадгална. Хоосон бол хадгалахгүй.
# Утгуудыг `railway bucket credentials --bucket spreadsheet-files`-ээс авна.
BUCKET_NAME=
BUCKET_ENDPOINT=
BUCKET_REGION=auto
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
# Дуут зурвасыг (Record Voice Message) текст болгох. Хоосон бол унтраалттай.
# Түлхүүрийг https://elevenlabs.io/app/settings/api-keys-ээс авна (Speech to Text эрхтэй).
ELEVENLABS_API_KEY=
# Scribe модель ба хэл (mon = монгол, auto = автоматаар таних)
STT_MODEL=scribe_v3
STT_LANGUAGE=mon
# Дуут зурвасын текстийг Claude-д асуулт болгон өгөх (off бол зөвхөн текст болгоно)
VOICE_TO_CLAUDE=on
# Дуут зурвасын хариултыг дуугаар (MP3) текстийн хамт илгээх. off бол зөвхөн текст.
TTS=on
# Дуу хоолой (хоосон бол Sarah, үнэгүй багцад ажиллана), модель, хэл. eleven_v4 монгол хэл дэмжинэ.
TTS_VOICE_ID=
TTS_MODEL=eleven_v4
TTS_LANGUAGE=mn
# Үүнээс урт хариултыг дуу болгохгүй (зөвхөн текст)
TTS_MAX_CHARS=1500

# ---------- Bridge (энэ Mac дээр ажиллана) ----------
# Claude Code-г ямар хавтаст ажиллуулах вэ (тэр хавтасны кодыг уншиж чадна)
CLAUDE_WORKDIR=/Users/bold0322/Documents/way-project
# claude CLI-ийн зам
CLAUDE_BIN=claude
# Нэмэлт аргумент. Жишээ: --model sonnet  эсвэл  --dangerously-skip-permissions
CLAUDE_EXTRA_ARGS=
# Зөвшөөрөгдсөн tool-ууд (анхдагчаар зөвхөн унших)
CLAUDE_ALLOWED_TOOLS=Read,Glob,Grep
# Нэг хүсэлтийн хамгийн их хугацаа (мс)
CLAUDE_TIMEOUT_MS=600000
# Шинэ хүсэлт шалгах давтамж (мс)
BRIDGE_POLL_INTERVAL_MS=3000
# Prompt-д оруулах сүүлийн чатын тоо (context)
CONTEXT_MESSAGES=15
# Google Drive дээрх файлыг хайх/унших/засах (claude.ai connector). Унтраах бол off.
GOOGLE_DRIVE=on
# Drive файл засах эрхтэй Discord хэрэглэгчийн ID-ууд (таслалаар). Хоосон бол хүн бүр.
DRIVE_WRITE_USER_IDS=
# Spreadsheet хавсралтын хамгийн их хэмжээ (MB)
SPREADSHEET_MAX_MB=25
# Засварын скрипт алдаа гаргавал Claude-аар хэдэн удаа засуулах вэ
SPREADSHEET_MAX_REPAIRS=2
# Засварын скриптийн хамгийн их хугацаа (мс)
SPREADSHEET_SCRIPT_TIMEOUT_MS=120000
